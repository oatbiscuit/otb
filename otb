readonly VERSION="0.1.0"
readonly APP_DIR="otb"
readonly XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly CONFIG_FILE="${XDG_CONFIG_HOME}/${APP_DIR}/config"
readonly CHECKSUMS_FILE="${XDG_DATA_HOME}/${APP_DIR}/checksums"

IMG_ROOT="${IMG_ROOT:-$HOME/Pictures}"
EDITOR="${EDITOR:-vi}"
DRY_RUN="${DRY_RUN:-0}"
VERBOSE="${VERBOSE:-0}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    readonly C_YELLOW='\033[1;33m'
    readonly C_RESET='\033[m'
else
    readonly C_YELLOW=''
    readonly C_RESET=''
fi

log() {
    prefix="${2:-->}"
    printf '%b%s%b %s\n' \
        "$C_YELLOW" "$prefix" "$C_RESET" "$1" >&2
}

die() {
    code="${2:-1}"
    printf '%s: %s.\n' "${0##*/}" "$1" >&2
    exit "$code"
}

warn() {
    log "$1" "WARNING"
}

verbose() {
    [ "${VERBOSE}" -eq 1 ] && log "$1" "VERBOSE"
}

has() {
    _cmd=$(command -v "$1") 2>/dev/null || return 1
    [ -x "$_cmd" ] || return 1
}

chk_depends() {
    missing=0
    has b3sum || { warn 'depends - b3sum not found'; missing=1; }
    has exiftool || { warn 'depends - exiftool not found'; missing=1; }
    [ "$missing" -eq 1 ] && die 'missing dependencies' || return 0
}

glob() {
    case "$1" in 
        "$2") return 0 ;; 
        *) return 1 ;; 
    esac
}

yn() {
    printf '%s [y/n]: ' "$1"
    stty -icanon
    answer=$(dd ibs=1 count=1 2>/dev/null || read -r answer)
    stty icanon
    printf '\n'
    glob "$answer" '[yY]'
}

get_root() {
    if [ -n "${TARGET_DIR:-}" ]; then
        echo "$TARGET_DIR"
        return
    fi

    if [ -f "$CONFIG_FILE" ]; then
        while IFS='=' read -r key value; do
            case "$key" in
                \#*|'') continue ;;
            esac
            key=$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            value=$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            case "$key" in
                root_dir) echo "$value"; return ;;
            esac
        done < "$CONFIG_FILE"
    fi

    echo "$IMG_ROOT"
}

get_image_date() {
    die 'TODO'
}

cmd_import() {
    src="${1:-}"
    target=$(get_root)

    [ -z "$src" ] && die 'import - source directory required'
    [ ! -d "$src" ] && die "import - '$src' is not a directory"

    log "src location: ${src}"
    log "target location: ${target}"
}

