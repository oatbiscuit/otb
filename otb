readonly VERSION="0.1.0"
readonly APP_DIR="otb"
readonly XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly CONFIG_FILE="${XDG_CONFIG_HOME}/${APP_DIR}/config"
readonly CHECKSUMS_FILE="${XDG_DATA_HOME}/${APP_DIR}/checksums"
readonly METADATA_FILE="${XDG_DATA_HOME}/${APP_DIR}/metadata"

SEP="$(printf '|')"
readonly SEP

IMG_ROOT="${IMG_ROOT:-${HOME}/Pictures}"
EDITOR="${EDITOR:-vi}"
DRY_RUN="${DRY_RUN:-0}"
VERBOSE="${VERBOSE:-0}"
TEMPLATE="${TEMPLATE:-%Y/%m}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    readonly C_YELLOW='\033[1;33m'
    readonly C_RESET='\033[m'
else
    readonly C_YELLOW=''
    readonly C_RESET=''
fi

log() {
    prefix="${2:-->}"
    printf '%b%s%b %s\n' \
        "$C_YELLOW" "$prefix" "$C_RESET" "$1" >&2
}

die() {
    code="${2:-1}"
    printf '%s: %s.\n' "${0##*/}" "$1" >&2
    exit "$code"
}

warn() {
    log "$1" "WARNING"
}

verbose() {
    if [ "$VERBOSE" -eq 1 ]; then
        log "$1" "VERBOSE"
    fi
    return 0
}

has() {
    _cmd=$(command -v "$1") 2>/dev/null || return 1
    [ -x "$_cmd" ] || return 1
}

chk_depends() {
    missing=0
    has b3sum || { warn 'depends - b3sum not found'; missing=1; }
    has exiftool || { warn 'depends - exiftool not found'; missing=1; }
    [ "$missing" -eq 1 ] && die 'missing dependencies' || return 0
}

glob() {
    # shellcheck disable=2254
    case "$1" in 
        $2) return 0 ;; 
        *) return 1 ;; 
    esac
}

yn() {
    printf '%s [y/n]: ' "$1"
    stty -icanon
    answer=$(dd ibs=1 count=1 2>/dev/null || read -r answer)
    stty icanon
    printf '\n'
    glob "$answer" '[yY]'
}

ask_number() {
    prompt="$1"
    max="$2"
    while :; do
        printf '%s [1-%d]: ' "$prompt" "$max" >&2
        read -r answer
        case "$answer" in
            ''|*[!0-9]*) continue ;;
        esac
        if [ "$answer" -ge 1 ] && [ "$answer" -le "$max" ]; then
            printf '%s\n' "$answer"
            return 0
        fi
    done
}

cleanup_tmp() {
    [ -n "${tmp_files:-}" ] && rm -f "$tmp_files"
    trap - EXIT INT TERM
}

create_default_config() {
    cat > "$CONFIG_FILE" << 'EOF'
# otb configuration file

# Directory where photos are stored
# Default: ~/Pictures
# Override: --target DIR or IMG_ROOT environment variable.
root_dir = ~/Pictures

# Import organization template
# Available variables:
#   %Y - Year (e.g., 2026)
#   %m - Month (e.g., 05)
#   %d - Day (e.g., 10)
#   %f - Filename (without extension)
#   %e - File extension (e.g., jpg)
# Examples:
#   %Y/%m              -> 2026/10/
#   %Y-%m-%d           -> 2026-05-10/
#   %Y/%m/%d           -> 2026/05/10/
#   Events/%Y/%m       -> Events/2026/05/
#   RAW/%Y/%m          -> RAW/2026/05/ (for RAW files)
# Priority (highest to lowest):
#    1. --template CLI option
#    2. IMPORT_TEMPLATE environment variable
#    3. import_template in config file
#    4. %Y/%m (default)
import_template = %Y/%m

# Editor for configuration
# Default: vi (or $EDITOR environment variable)
editor = vi
EOF
}

human_size() {
    bytes="$1"
    if [ "$bytes" -ge 1073741824 ]; then
        printf '%d.%d GB' $((bytes / 1073741824)) $((bytes % 1073741824 / 107374182))
    elif [ "$bytes" -ge 1048576 ]; then
        printf '%d.%d MB' $((bytes / 1048576)) $((bytes % 1048576 / 104857))
    elif [ "$bytes" -ge 1024 ]; then
        printf '%d.%d KB' $((bytes / 1024)) $((bytes % 1024 / 102))
    else
        printf '%d B' "$bytes"
    fi
}

expand_path() {
    path="$1"
    path=$(echo "$path" | sed "s|^~|$HOME|")
    path=$(echo "$path" | sed "s|\\\$HOME|$HOME|g")
    echo "$path"
}

get_config() {
    key="$1"
    default="${2:-}"

    env_var=$(echo "$key" | tr '[:lower:]' '[:upper:]')
    eval "value=\${$env_var:-}"
    if [ -n "$value" ]; then
        expand_path "$value"
        return
    fi

    if [ -f "$CONFIG_FILE" ]; then
        while IFS='=' read -r k v; do
            case "$k" in
                \#*|'') continue ;;
            esac
            k=$(echo "$k" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            v=$(echo "$v" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            if [ "$k" = "$key" ]; then
                expand_path "$v"
                return
            fi
        done < "$CONFIG_FILE"
    fi
    
    expand_path "$default"
}

get_root() {
    if [ -n "${TARGET_DIR:-}" ]; then
        printf '%s\n' "$TARGET_DIR" 
        return
    fi
    result=$(get_config "root_dir" "$IMG_ROOT")
    printf '%s\n' "$result"
}

get_import_template() {
    if [ -n "$TEMPLATE" ]; then
        echo "$TEMPLATE"
        return
    fi

    if [ -n "$IMPORT_TEMPLATE" ]; then
        echo "${IMPORT_TEMPLATE}"
        return
    fi
    
    get_config "import_template" "%Y/%m"
}

get_sidecar_path() {
    file="$1"
    result="${file}.xmp"

    echo "$result"
}

is_image_file(){
    _lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$_lower" in
        *.jpg|*.jpeg|*.png|*.gif|*.cr2|*.nef|*.arw|*.dng|*.orf|*.rw2|*.raf|*.pef|*.srw) return 0 ;;
        *) return 1 ;;
    esac
}

find_images() {
    dir="$1"
    find "$dir" -type f 2>/dev/null | while read -r f; do
        if is_image_file "$f"; then
            printf '%s\n' "$f"
        fi
    done
    return 0
}

has_sidecar() {
    [ -f "$(get_sidecar_path "$1")" ]
}

get_tags() {
    file="$1"
    sidecar="$(get_sidecar_path "$file")"

    if [ -f "$sidecar" ]; then
        exiftool -s3 -sep ", " -XMP-dc:Subject "$sidecar" 2>/dev/null | \
            tr ',' '\n' | sed 's/^ // ;s/ $//' | grep -v '^$' || true
    else
        exiftool -s3 -sep ", " -XMP-dc:Subject "$file" 2>/dev/null | \
            tr ',' '\n' | sed 's/^ // ;s/ $//' | grep -v '^$' || true
    fi
    return 0
}

add_tag() {
    file="$1"
    tag="$2"
    sidecar=$(get_sidecar_path "$file")

    if [ -f "$sidecar" ]; then
        exiftool -XMP-dc:Subject+="$tag" "$sidecar" >/dev/null 2>&1
    else
        exiftool -o "$sidecar" -XMP-dc:Subject+="$tag" "$file" >/dev/null 2>&1
    fi
}

remove_tag() {
    file="$1"
    tag="$2"
    sidecar=$(get_sidecar_path "$file")

    if [ -f "$sidecar" ]; then
        exiftool -XMP-dc:Subject-="$tag" "$sidecar" >/dev/null 2>&1
    fi
}

get_rating() {
    file="$1"
    sidecar="$(get_sidecar_path "$file")"

    if [ -f "$sidecar" ]; then
        exiftool -s3 -XMP:Rating "$sidecar" 2>/dev/null | head -1
    else
        exiftool -s3 -XMP:Rating "$file" 2>/dev/null | head -1
    fi
}

set_rating() {
    file="$1"
    rating="$2"
    sidecar=$(get_sidecar_path "$file")

    if [ -f "$sidecar" ]; then
        exiftool -XMP:Rating="$rating" "$sidecar" >/dev/null 2>&1
    else
        exiftool -o "$sidecar" -XMP:Rating="$rating" "$file" >/dev/null 2>&1
    fi
}

clear_rating() {
    file="$1"
    sidecar=$(get_sidecar_path "$file")

    [ ! -f "$sidecar" ] && return 0

    exiftool -XMP:Rating= "$sidecar" >/dev/null 2>&1
}

get_image_date() {
    file="$1"

    date=$(exiftool -s3 -DateTimeOriginal -d "%Y-%m-%d" "$file" 2>/dev/null | head -1)

    if [ -n "$date" ]; then
        echo "$date"
        return
    fi

    date=$(date -r "$file" +"%Y-%m-%d" 2>/dev/null)

    if [ -n "$date" ]; then
        echo "$date"
        return
    fi
    
    date=$(date +"%Y-%m-%d")
    echo "$date"
}

get_metadata_field() {
    file="$1"
    field="$2"
    
    awk -F"$SEP" -v f="$file" -v n="$((field + 1))" '
        $1 == f { print $n; exit }
    ' "$METADATA_FILE" 2>/dev/null
}

metadata_update() {
    file="$1"
    tags="$2"
    rating="$3"
    timestamp=$(date +%s)

    metadata_remove "$file"
    printf '%s%s%s%s%s%s%s\n' \
        "$file" "$SEP" "$tags" "$SEP" "$rating" "$SEP" "$timestamp" \
        >> "$METADATA_FILE"
}

metadata_remove() {
    file="$1"

    if awk -F"$SEP" -v f="$file" '$1 != f' "$METADATA_FILE" \
        > "${METADATA_FILE}.tmp" 2>/dev/null; then
        mv "${METADATA_FILE}.tmp" "$METADATA_FILE" || true
    else
        rm -f "${METADATA_FILE}.tmp" || true
    fi
    return 0
}

metadata_sync_from_xmp() {
    file="$1"

    tags=$(get_tags "$file")
    rating=$(get_rating "$file")

    tags_joined=$(printf '%s\n' "$tags" | tr '\n' ',' | sed "s/,$//")

    metadata_update "$file" "$tags_joined" "$rating"
}

metadata_sync_from_files() {
    dir=${1:-$(get_root)}
    count=0

    log "syncing metadata from: $dir"

    while read -r file; do
        case "$file" in
            *.xmp) continue ;;
        esac

        if is_image_file "$file"; then
            metadata_sync_from_xmp "$file"
            count=$((count + 1))
            verbose "synced: $file"
        fi
    done <<EOF
$(find "$dir" -type f 2>/dev/null || true)
EOF

    log "synced $count files"
}

checksums_remove() {
    path="$1"
    if awk -F"$SEP" -v p="$path" '$2 != p' "$CHECKSUMS_FILE" \
        > "${CHECKSUMS_FILE}.tmp" 2>/dev/null; then
        mv "${CHECKSUMS_FILE}.tmp" "$CHECKSUMS_FILE" || true
    else
        rm -f "${CHECKSUMS_FILE}.tmp" || true
    fi
    return 0
}

process_tag_file() {
    file="$1"
    index="$2"
    total="$3"
    filename="${file##*/}"

    if ! is_image_file "$file"; then
        warn "tag: $index/$total $filename (skipped, not an image)"
        return 0
    fi
    
    sidecar=$(get_sidecar_path "$file")
    verbose "tag:   src: $file"
    verbose "tag:   sidecar: $sidecar"
    
    current_tags="|$(get_tags "$file" | tr '\n' '|')"

    added_this=0
    removed_this=0
    skipped_this=0
    
    for tag in $add_tags; do
        if echo "$current_tags" | grep -q "|$tag|"; then
            verbose "tag:   '$tag' already exists"
            skipped_this=$((skipped_this + 1))
            tag_skipped=$((tag_skipped + 1 ))
        else
            add_tag "$file" "$tag"
            verbose "tag:   added '$tag'"
            current_tags="$current_tags$tag|"
            added_this=$((added_this + 1))
            tag_added=$((tag_added + 1))
        fi
    done

    for tag in $delete_tags; do
        if echo "$current_tags" | grep -q "|$tag|"; then
            remove_tag "$file" "$tag"
            verbose "tag:   removed '$tag'"
            current_tags=$(echo "$current_tags" | sed "s/|$tag|/|/")
            removed_this=$((removed_this + 1))
            tag_removed=$((tag_removed + 1))
        else
            verbose "tag:   '$tag' not found"
            skipped_this=$((skipped_this + 1))
            tag_skipped=$((tag_skipped + 1))
        fi
    done

    summary=""
    [ "$added_this" -gt 0 ] && summary="$summary, $added_this added"
    [ "$removed_this" -gt 0 ] && summary="$summary, $removed_this removed"
    [ "$skipped_this" -gt 0 ] && summary="$summary, $skipped_this skipped"
    summary="${summary#, }"

    if [ "$list_tags" -eq 1 ]; then
        log "tag:   $index/$total $filename"
        get_tags "$file" | while read -r tag; do
            printf '        - %s\n' "$tag"
        done
    else
        log "tag:   $index/$total $filename ($summary)"
        metadata_sync_from_xmp "$file"
    fi
    return 0
}

process_rate_file() {
    file="$1"
    index="$2"
    total="$3"
    filename="${file##*/}"

    if ! is_image_file "$file"; then
        warn "rate: $index/$total $filename (skipped, not an image)"
        rate_skipped=$((rate_skipped + 1))
        return 0
    fi

    current=$(get_rating "$file")

    if [ "$list" -eq 1 ]; then
        log "rate:   $index/$total $filename"
        printf '        rating: %s\n' "${current:-none}"
        return 0
    fi

    if [ -n "$set_value" ]; then
        case "$set_value" in
            [1-5]) ;;
            *) die "rate: rating must be 1-5" ;;
        esac
        set_rating "$file" "$set_value"
        log "rate:   $index/$total $filename (set to $set_value)"
        rate_set=$((rate_set + 1))
    elif [ "$up" -eq 1 ]; then
        if [ -z "$current" ]; then
            set_rating "$file" 1
            log "rate:   $index/$total $filename (set to 1)"
        else
            new=$((current + 1))
            [ "$new" -gt 5 ] && new=5
            set_rating "$file" "$new"
            log "rate:   $index/$total $filename ($current -> $new)"
        fi
        rate_set=$((rate_set + 1))
    elif [ "$down" -eq 1 ]; then
        if [ -z "$current" ] || [ "$current" -eq 0 ]; then
            log "rate:   $index/$total $filename (skipped, no rating)"
            rate_skipped=$((rate_skipped + 1))
            return 0
        fi
        new=$((current - 1))
        [ "$new" -lt 1 ] && new=1
        set_rating "$file" "$new"
        log "rate:   $index/$total $filename ($current -> $new)"
        rate_set=$((rate_set + 1))
    elif [ "$clear" -eq 1 ]; then
        clear_rating "$file"
        log "rate:   $index/$total $filename (cleared)"
        rate_cleared=$((rate_cleared + 1))
    fi

    metadata_sync_from_xmp "$file"
    return 0
}

process_dupe_group() {
    _pg_hash="$1"
    _pg_paths="$2"
    _pg_size="$3"

    _pg_count=$(printf '%s\n' "$_pg_paths" | grep -c . || true)
    [ "$_pg_count" -lt 2 ] && return 0

    group_count=$((group_count + 1))
    total_dupes=$((total_dupes + _pg_count - 1))
    total_size=$((total_size + _pg_size))

    log "Group $group_count ($(human_size "$_pg_size")):"

    _pg_i=1
    while IFS= read -r _pg_p; do
        [ -z "$_pg_p" ] && continue
        printf '   %d. %s\n' "$_pg_i" "$_pg_p" >&2
        _pg_i=$((_pg_i + 1))
    done <<EOF
$_pg_paths
EOF

    if [ "$delete_flag" -eq 0 ]; then
        return 0
    fi

    _pg_keep=$(ask_number "Which file to keep?" "$_pg_count")
    _pg_to_delete=$((_pg_count - 1))

    if [ "$_pg_to_delete" -eq 1 ]; then
        _pg_prompt="Delete the other file?"
    else
        _pg_prompt="Delete the other $_pg_to_delete files?"
    fi

    if ! yn "$_pg_prompt"; then
        verbose "dupes: skipped group $group_count"
        return 0
    fi

    _pg_i=1
    while IFS= read -r _pg_p; do
        [ -z "$_pg_p" ] && continue
        if [ "$_pg_i" -ne "$_pg_keep" ]; then
            if [ -f "$_pg_p" ]; then
                _pg_file_size=$(wc -c < "$_pg_p" 2>/dev/null || echo 0)
                if [ "$DRY_RUN" -eq 1 ]; then
                    log "dupes: would delete $_pg_p"
                    deleted_count=$((deleted_count + 1))
                    freed_size=$((freed_size + _pg_file_size))
                else
                    if rm -f "$_pg_p"; then
                        log "dupes: deleted $_pg_p"
                        deleted_count=$((deleted_count + 1))
                        freed_size=$((freed_size + _pg_file_size))
                        checksums_remove "$_pg_p"
                    fi
                fi
            fi
        fi
        _pg_i=$((_pg_i + 1))
    done <<EOF
$_pg_paths
EOF

    return 0
}

build_target_path() {
    file="$1"
    date="$2"
    template=$(get_import_template)

    year=$(echo "$date" | cut -d- -f1)
    month=$(echo "$date" | cut -d- -f2)
    day=$(echo "$date" | cut -d- -f3)
    filename="${file##*/}"
    extension="${filename##*.}"
    basename="${filename%.*}"

    result="$template"
    result=$(echo "$result" | sed "s/%Y/$year/g")
    result=$(echo "$result" | sed "s/%m/$month/g")
    result=$(echo "$result" | sed "s/%d/$day/g")
    result=$(echo "$result" | sed "s/%f/$basename/g")
    result=$(echo "$result" | sed "s/%e/$extension/g")

    result=$(echo "$result" | sed 's/\/\//\//g' | sed 's/^\/\///')
    echo "$result"
}

sanitize_filename() {
    filename="$1"
    
    result="$filename"
    result=$(echo "$result" | tr ' ' '_')
    result=$(echo "$result" | sed 's/[^-a-zA-Z0-9._]/_/g')
    result=$(echo "$result" | sed 's/-_/-/g')
    result=$(echo "$result" | sed 's/_-/-/g')
    result=$(echo "$result" | sed 's/__*/_/g')
    result=$(echo "$result" | tr '[:upper:]' '[:lower:]')

    echo "$result"
}

cmd_import() {
    src="${1:-}"
    target=$(get_root)
    copied=0
    skipped=0
    renamed=0
    index=0

    [ -z "$src" ] && die 'import - source directory required'
    [ ! -d "$src" ] && die "import - '$src' is not a directory"

    log "src location: ${src}"
    log "target location: ${target}"

    tmp_files=$(mktemp) || die "could not create temp file"
    trap 'rm -f "$tmp_files"' EXIT INT TERM

    find "$src" -type f > "$tmp_files" 2>/dev/null || true
    count=$(wc -l < "$tmp_files")

    log "found $count files..."
    while read -r file; do
        filename="${file##*/}"
        printf '%s\n' "   - $filename"
    done < "$tmp_files"

    if [ "$DRY_RUN" -eq 1 ]; then
        log "DRY RUN: would copy $count files to $target"
        cleanup_tmp
        return
    fi

    if ! yn "copy these $count files?"; then
        log 'import cancelled'
        cleanup_tmp
        return
    fi

    log "import: starting $count files..."

    while read -r file; do
        index=$((index + 1))
        filename="${file##*/}"
        date=$(get_image_date "$file")
        template=$(get_import_template)
        path_template=$(build_target_path "$file" "$date")

        case "$template" in
            *%f*|*%e*)
                target_path="$target/$(dirname "$path_template")"
                new_filename=$(basename "$path_template")
                ;;
            *)
                target_path="$target/$path_template"
                new_filename="$filename"
                ;;
        esac
    
        new_filename=$(sanitize_filename "$new_filename")

        mkdir -p "$target_path"

        if [ -f "$target_path/$new_filename" ]; then
            existing_hash=$(b3sum "$target_path/$new_filename" | cut -d' ' -f1)
            new_hash=$(b3sum "$file" | cut -d' ' -f1)
            if [ "$existing_hash" = "$new_hash" ]; then
                log "import: $index/$count $filename (skipped, identical)"
                skipped=$((skipped + 1))
                continue
            else
                base="${new_filename%.*}"
                ext="${new_filename##*.}"
                base=$(echo "$base" | sed 's/-[0-9]\+$//')

                i=1
                while [ -f "$target_path/${base}-${i}.$ext" ]; do
                    i=$((i + 1))
                done

                new_filename="${base}-${i}.$ext"
                log "import: $index/$count $filename (renamed to $new_filename)"
                renamed=$((renamed + 1))
            fi
        else
            log "import: $index/$count $filename"
        fi

        verbose "import:    src: $file"
        verbose "import:    dst: $target_path/$new_filename"
        
        cp "$file" "$target_path/$new_filename"
        [ -f "$target_path/$new_filename" ] || die "copy failed: $file"

        hash=$(b3sum "$target_path/$new_filename" | cut -d' ' -f1)
        verbose "import:    hash: $hash"

        printf '%s%s%s%s%s\n' \
            "$hash" "$SEP" "$target_path/$new_filename" "$SEP" "$(date +%s)" \
            >> "$CHECKSUMS_FILE"
        
        copied=$((copied + 1))
    done < "$tmp_files"

    cleanup_tmp
    log "import complete: $count files ($copied copied, $skipped skipped, $renamed renamed)"
}

cmd_tag() {
    add_tags=""
    delete_tags=""
    list_tags=0
    recursive=0
    files=""
    tag_added=0
    tag_removed=0
    tag_skipped=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -a|--add) add_tags="$add_tags $2"; shift 2 ;;
            -d|--delete) delete_tags="$delete_tags $2"; shift 2 ;;
            -l|--list) list_tags=1; shift ;;
            -r|--recursive) recursive=1; shift ;;
            -*) die "tag: unknown option '$1'" ;;
            *) files="$files $1"; shift ;;
        esac
    done

    [ -z "$files" ] && die "tag: file or directory required"
    [ -z "$add_tags" ] && [ -z "$delete_tags" ] && [ "$list_tags" -eq 0 ] && \
        die "tag: specify -a/--add, -d/--delete, or -l/--list"

    tmp_files=$(mktemp) || die "tag: could not create temp file"
    trap 'rm -f "$tmp_files"' EXIT INT TERM 

    for item in $files; do
        if [ -f "$item" ]; then
            printf '%s\n' "$item" >> "$tmp_files"
        elif [ -d "$item" ] && [ "$recursive" -eq 1 ]; then
            find_images "$item" >> "$tmp_files" || true
        elif [ -d "$item" ]; then
            warn "tag: skipping directory '$item' (use -r or --recursive)"
        else
            warn "tag: skipping '$item' (not found)"
        fi
    done

    count=$(wc -l < "$tmp_files")
    if [ "$count" -eq 0 ]; then
        log "tag: no files to process"
        cleanup_tmp
        return
    fi

    [ "$list_tags" -eq 0 ] && log "tag: starting $count files..."

    index=0
    while read -r file; do
        index=$((index + 1))
        process_tag_file "$file" "$index" "$count"
    done < "$tmp_files"

    cleanup_tmp

    if [ "$list_tags" -eq 0 ]; then
        log "tag complete: $tag_added added, $tag_removed removed, $tag_skipped skipped"
    fi
}

cmd_rate() {
    set_value=""
    up=0
    down=0
    clear=0
    list=0
    recursive=0
    files=""
    rate_set=0
    rate_cleared=0
    rate_skipped=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -s|--set) set_value="$2"; shift 2 ;;
            -u|--up) up=1; shift ;;
            -d|--down) down=1; shift ;;
            -c|--clear) clear=1; shift ;;
            -l|--list) list=1; shift ;;
            -r|--recursive) recursive=1; shift ;;
            -*) die "rate: unknown option '$1'" ;;
            *) files="$files $1"; shift ;;
        esac
    done

    [ -z "$files" ] && die "rate: file or directory required"
    [ -z "$set_value" ] && [ "$up" -eq 0 ] && [ "$down" -eq 0 ] && \
        [ "$clear" -eq 0 ] && [ "$list" -eq 0 ] && \
        die "rate: specify -s/--set, -u/--up, -d/--down, -c/--clear, or -l/--list"
    
    tmp_files=$(mktemp) || die "rate: could not create temp file"
    trap 'rm -f "$tmp_files"' EXIT INT TERM

    for item in $files; do
        if [ -f "$item" ]; then
            printf '%s\n' "$item" >> "$tmp_files"
        elif [ -d "$item" ] && [ "$recursive" -eq 1 ]; then
            find_images "$item" >> "$tmp_files" || true
        elif [ -d "$item" ]; then
            warn "rate: skipping directory '$item' (use -r or --recursive)"
        else
            warn "rate: skipping '$item' (not found)"
        fi
    done

    count=$(wc -l < "$tmp_files")
    if [ "$count" -eq 0 ]; then
        log "rate: no files to process"
        cleanup_tmp
        return
    fi

    [ "$list" -eq 0 ] && log "rate: starting $count files..."

    index=0
    while read -r file; do
        index=$((index + 1))
        process_rate_file "$file" "$index" "$count"
    done < "$tmp_files"

    cleanup_tmp

    if [ "$list" -eq 0 ]; then
        log "rate complete: $rate_set set, $rate_cleared cleared, $rate_skipped skipped"
    fi
}

cmd_dupes() {
    delete_flag=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -d|--delete) delete_flag=1; shift ;;
            -*) die "dupes: unknown option '$1'" ;;
            *) die "dupes: unexpected argument '$1'" ;;
        esac
    done

    if [ ! -s "$CHECKSUMS_FILE" ]; then
        log 'dupes: no checksums found'
        return 0
    fi

    log 'dupes: scanning checksums...'

    tmp_files=$(mktemp) || die 'dupes: could not create temp file'
    trap 'rm -f "$tmp_files"' EXIT INT TERM

    sort -t"$SEP" -k1 "$CHECKSUMS_FILE" > "$tmp_files" || true

    group_count=0
    total_dupes=0
    total_size=0
    deleted_count=0
    freed_size=0

    prev_hash=""
    group_paths=""
    group_size=0

    while IFS="$SEP" read -r hash path _ <&3; do
        if [ "$hash" = "$prev_hash" ]; then
            if [ -z "$group_paths" ]; then
                group_paths="$path"
            else
                group_paths=$(printf '%s\n%s' "$group_paths" "$path")
            fi

            if [ -f "$path" ]; then
                sz=$(wc -c < "$path" 2>/dev/null || echo 0)
                group_size=$((group_size + sz))
            fi
        else
            if [ -n "$prev_hash" ]; then
                process_dupe_group "$prev_hash" "$group_paths" "$group_size"
            fi
            prev_hash="$hash"
            group_paths="$path"

            group_size=0
            if [ -f "$path" ]; then
                group_size=$(wc -c < "$path" 2>/dev/null || echo 0)
            fi
        fi
    done 3< "$tmp_files"

    if [ -n "$prev_hash" ]; then
        process_dupe_group "$prev_hash" "$group_paths" "$group_size"
    fi

    if [ "$group_count" -eq 0 ]; then
        log 'dupes: no duplicates found'
        cleanup_tmp
        return 0
    fi

    if [ "$delete_flag" -eq 1 ]; then
        log "dupes: deleted $deleted_count files, freed $(human_size "$freed_size")"
    else
        log "dupes: $group_count group(s), $total_dupes duplicate(s), $(human_size "$total_size") recoverable"
    fi

    cleanup_tmp
}

