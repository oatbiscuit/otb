readonly VERSION="0.1.0"
readonly APP_DIR="otb"
readonly XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly CONFIG_FILE="${XDG_CONFIG_HOME}/${APP_DIR}/config"
readonly CHECKSUMS_FILE="${XDG_DATA_HOME}/${APP_DIR}/checksums"
readonly METADATA_FILE="${XDG_DATA_HOME}/${APP_DIR}/metadata"

IMG_ROOT="${IMG_ROOT:-${HOME}/Pictures}"
EDITOR="${EDITOR:-vi}"
DRY_RUN="${DRY_RUN:-0}"
VERBOSE="${VERBOSE:-0}"
TEMPLATE="${TEMPLATE:-%Y/%m}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    readonly C_YELLOW='\033[1;33m'
    readonly C_RESET='\033[m'
else
    readonly C_YELLOW=''
    readonly C_RESET=''
fi

log() {
    prefix="${2:-->}"
    printf '%b%s%b %s\n' \
        "$C_YELLOW" "$prefix" "$C_RESET" "$1" >&2
}

die() {
    code="${2:-1}"
    printf '%s: %s.\n' "${0##*/}" "$1" >&2
    exit "$code"
}

warn() {
    log "$1" "WARNING"
}

verbose() {
    [ "$VERBOSE" -eq 1 ] && log "$1" "VERBOSE"
}

has() {
    _cmd=$(command -v "$1") 2>/dev/null || return 1
    [ -x "$_cmd" ] || return 1
}

chk_depends() {
    missing=0
    has b3sum || { warn 'depends - b3sum not found'; missing=1; }
    has exiftool || { warn 'depends - exiftool not found'; missing=1; }
    [ "$missing" -eq 1 ] && die 'missing dependencies' || return 0
}

glob() {
    # shellcheck disable=2254
    case "$1" in 
        $2) return 0 ;; 
        *) return 1 ;; 
    esac
}

yn() {
    printf '%s [y/n]: ' "$1"
    stty -icanon
    answer=$(dd ibs=1 count=1 2>/dev/null || read -r answer)
    stty icanon
    printf '\n'
    glob "$answer" '[yY]'
}

cleanup_tmp() {
    [ -n "${tmp_files:-}" ] && rm -f "$tmp_files"
    trap - EXIT INT TERM
}

create_default_config() {
    cat > "$CONFIG_FILE" << 'EOF'
# otb configuration file

# Directory where photos are stored
# Default: ~/Pictures
# Override: --target DIR or IMG_ROOT environment variable.
root_dir = ~/Pictures

# Import organization template
# Available variables:
#   %Y - Year (e.g., 2026)
#   %m - Month (e.g., 05)
#   %d - Day (e.g., 10)
#   %f - Filename (without extension)
#   %e - File extension (e.g., jpg)
# Examples:
#   %Y/%m              -> 2026/10/
#   %Y-%m-%d           -> 2026-05-10/
#   %Y/%m/%d           -> 2026/05/10/
#   Events/%Y/%m       -> Events/2026/05/
#   RAW/%Y/%m          -> RAW/2026/05/ (for RAW files)
# Priority (highest to lowest):
#    1. --template CLI option
#    2. IMPORT_TEMPLATE environment variable
#    3. import_template in config file
#    4. %Y/%m (default)
import_template = %Y/%m

# Editor for configuration
# Default: vi (or $EDITOR environment variable)
editor = vi
EOF
}

expand_path() {
    path="$1"
    path=$(echo "$path" | sed "s|^~|$HOME|")
    path=$(echo "$path" | sed "s|\\\$HOME|$HOME|g")
    echo "$path"
}

get_config() {
    key="$1"
    default="${2:-}"

    env_var=$(echo "$key" | tr '[:lower:]' '[:upper:]')
    eval "value=\${$env_var:-}"
    if [ -n "$value" ]; then
        expand_path "$value"
        return
    fi

    if [ -f "$CONFIG_FILE" ]; then
        while IFS='=' read -r k v; do
            case "$k" in
                \#*|'') continue ;;
            esac
            k=$(echo "$k" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            v=$(echo "$v" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            if [ "$k" = "$key" ]; then
                expand_path "$v"
                return
            fi
        done < "$CONFIG_FILE"
    fi
    
    expand_path "$default"
}

get_root() {
    if [ -n "${TARGET_DIR:-}" ]; then
        printf '%s\n' "$TARGET_DIR" 
        return
    fi
    result=$(get_config "root_dir" "$IMG_ROOT")
    printf '%s\n' "$result"
}

get_import_template() {
    if [ -n "$TEMPLATE" ]; then
        echo "$TEMPLATE"
        return
    fi

    if [ -n "$IMPORT_TEMPLATE" ]; then
        echo "${IMPORT_TEMPLATE}"
        return
    fi
    
    get_config "import_template" "%Y/%m"
}

get_sidecar_path() {
    file="$1"
    result="${file}.xmp"

    echo "$result"
}

is_image_file(){
    _lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$_lower" in
        *.jpg|*.jpeg|*.png|*.gif|*.cr2|*.nef|*.arw|*.dng|*.orf|*.rw2|*.raf|*.pef|*.srw) return 0 ;;
        *) return 1 ;;
    esac
}

has_sidecar() {
    [ -f "$(get_sidecar_path "$1")" ]
}

get_tags() {
    file="$1"
    sidecar="$(get_sidecar_path "$file")"

    if [ -f "$sidecar" ]; then
        exiftool -s3 -sep ", " -XMP-dc:Subject "$sidecar" 2>/dev/null | \
            tr ',' '\n' | sed 's/^ // ;s/ $//' | grep -v '^$'
    else
        exiftool -s3 -sep ", " -XMP-dc:Subject "$file" 2>/dev/null | \
            tr ',' '\n' | sed 's/^ // ;s/ $//' | grep -v '^$'
    fi
}

add_tag() {
    file="$1"
    tag="$2"
    sidecar=$(get_sidecar_path "$file")

    if [ -f "$sidecar" ]; then
        exiftool -XMP-dc:Subject+="$tag" "$sidecar" >/dev/null 2>&1
    else
        exiftool -o "$sidecar" -XMP-dc:Subject+="$tag" "$file" >/dev/null 2>&1
    fi
}

remove_tag() {
    file="$1"
    tag="$2"
    sidecar=$(get_sidecar_path "$file")

    if [ -f "$sidecar" ]; then
        exiftool -XMP-dc:Subject-="$tag" "$sidecar" >/dev/null 2>&1
    fi
}

get_rating() {
    file="$1"
    sidecar="$(get_sidecar_path "$file")"

    if [ -f "$sidecar" ]; then
        exiftool -s3 -XMP:Rating "$sidecar" 2>/dev/null | head -1
    else
        exiftool -s3 -XMP:Rating "$file" 2>/dev/null | head -1
    fi
}

set_rating() {
    file="$1"
    rating="$2"
    sidecar=$(get_sidecar_path "$file")

    if [ -f "$sidecar" ]; then
        exiftool -XMP:Rating="$rating" "$sidecar" >/dev/null 2>&1
    else
        exiftool -o "$sidecar" -XMP:Rating="$rating" "$file" >/dev/null 2>&1
    fi
}

clear_rating() {
    file="$1"
    sidecar=$(get_sidecar_path "$file")

    [ ! -f "$sidecar" ] && return 0

    exiftool -XMP:Rating= "$sidecar" >/dev/null 2>&1
}

get_image_date() {
    file="$1"

    date=$(exiftool -s3 -DateTimeOriginal -d "%Y-%m-%d" "$file" 2>/dev/null | head -1)

    if [ -n "$date" ]; then
        echo "$date"
        return
    fi

    date=$(date -r "$file" +"%Y-%m-%d" 2>/dev/null)

    if [ -n "$date" ]; then
        echo "$date"
        return
    fi
    
    date=$(date +"%Y-%m-%d")
    echo "$date"
}

get_metadata_field() {
    file="$1"
    field="$2"

    grep "^$file|" "$METADATA_FILE" 2>/dev/null | cut -d'|' -f$((field + 1))
}

metadata_update() {
    file="$1"
    tags="$2"
    rating="$3"
    timestamp=$(date +%s)

    grep -v "^$file|" "$METADATA_FILE" > "${METADATA_FILE}.tmp" 2>/dev/null || true
    mv "${METADATA_FILE}.tmp" "$METADATA_FILE"

    echo "$file|$tags|$rating|$timestamp" >> "$METADATA_FILE"
}

metadata_remove() {
    file="$1"

    grep -v "^$file|" "$METADATA_FILE" > "${METADATA_FILE}.tmp" 2>/dev/null || true
    mv "${METADATA_FILE}.tmp" "$METADATA_FILE"
}

metadata_sync_from_xmp() {
    file="$1"

    tags=$(get_tags "$file")
    rating=$(get_rating "$file")

    tags_csv=$(echo "$tags" | tr '\n' ',' | sed 's/,$//')

    metadata_update "$file" "$tags_csv" "$rating"
}

metadata_sync_from_files() {
    dir=${1:-$(get_root)}
    count=0

    log "syncing metadata from: $dir"

    while read -r file; do
        case "$file" in
            *.xmp) continue ;;
        esac

        if is_image_file "$file"; then
            metadata_sync_from_xmp "$file"
            count=$((count + 1))
            verbose "synced: $file"
        fi
    done <<EOF
$(find "$dir" -type f 2>/dev/null)
EOF

    log "synced $count files"
}

process_tag_file() {
    file="$1"

    if ! is_image_file "$file"; then
        warn "tag: skipping non-image: $file"
        return
    fi
    
    filename=${file##*/}
    sidecar=$(get_sidecar_path "$file")
    current_tags="|$(get_tags "$file" | tr '\n' '|')"

    for tag in $add_tags; do
        if echo "$current_tags" | grep -q "|$tag|"; then
            log "tag: tag '$tag' already exists in $filename"
            tag_skipped=$((tag_skipped + 1 ))
        else
            add_tag "$file" "$tag"
            log "tag: added '$tag' to $filename"
            current_tags="$current_tags$tag|"
            tag_added=$((tag_added + 1))
        fi
    done

    for tag in $delete_tags; do
        if echo "$current_tags" | grep -q "|$tag|"; then
            remove_tag "$file" "$tag"
            log "tag: removed '$tag' from $filename"
            current_tags=$(echo "$current_tags" | sed "s/|$tag|/|/")
            tag_removed=$((tag_removed + 1))
        else
            log "tag: '$tag' not found in $filename"
            tag_skipped=$((tag_skipped + 1))
        fi
    done

    metadata_sync_from_xmp "$file"

    if [ "$list_tags" -eq 1 ]; then
        log "tags for $filename:"
        get_tags "$file" | while read -r tag; do
            printf '    - %s\n' "$tag"
        done
    fi
}

build_target_path() {
    file="$1"
    date="$2"
    template=$(get_import_template)

    year=$(echo "$date" | cut -d- -f1)
    month=$(echo "$date" | cut -d- -f2)
    day=$(echo "$date" | cut -d- -f3)
    filename="${file##*/}"
    extension="${filename##*.}"
    basename="${filename%.*}"

    result="$template"
    result=$(echo "$result" | sed "s/%Y/$year/g")
    result=$(echo "$result" | sed "s/%m/$month/g")
    result=$(echo "$result" | sed "s/%d/$day/g")
    result=$(echo "$result" | sed "s/%f/$basename/g")
    result=$(echo "$result" | sed "s/%e/$extension/g")

    result=$(echo "$result" | sed 's/\/\//\//g' | sed 's/^\/\///')
    echo "$result"
}

sanitize_filename() {
    filename="$1"
    
    result="$filename"
    result=$(echo "$result" | tr ' ' '_')
    result=$(echo "$result" | sed 's/[^-a-zA-Z0-9._]/_/g')
    result=$(echo "$result" | sed 's/-_/-/g')
    result=$(echo "$result" | sed 's/_-/-/g')
    result=$(echo "$result" | sed 's/__*/_/g')
    result=$(echo "$result" | tr '[:upper:]' '[:lower:]')

    echo "$result"
}

cmd_import() {
    src="${1:-}"
    target=$(get_root)
    copied=0
    skipped=0
    renamed=0

    [ -z "$src" ] && die 'import - source directory required'
    [ ! -d "$src" ] && die "import - '$src' is not a directory"

    log "src location: ${src}"
    log "target location: ${target}"

    tmp_files=$(mktemp) || die "could not create temp file"
    trap 'rm -f "$tmp_files"' EXIT INT TERM

    find "$src" -type f > "$tmp_files" 2>/dev/null || true
    count=$(wc -l < "$tmp_files")

    log "found $count files..."
    while read -r file; do
        filename="${file##*/}"
        printf '%s\n' "   - $filename"
    done < "$tmp_files"

    if [ "$DRY_RUN" -eq 1 ]; then
        log "DRY RUN: would copy $count files to $target"
        cleanup_tmp
        return
    fi

    if ! yn "copy these $count files?"; then
        log 'import cancelled'
        cleanup_tmp
        return
    fi

    while read -r file; do
        filename="${file##*/}"
        date=$(get_image_date "$file")
        template=$(get_import_template)
        path_template=$(build_target_path "$file" "$date")

        case "$template" in
            *%f*|*%e*)
                target_path="$target/$(dirname "$path_template")"
                new_filename=$(basename "$path_template")
                ;;
            *)
                target_path="$target/$path_template"
                new_filename="$filename"
                ;;
        esac
    
        new_filename=$(sanitize_filename "$new_filename")

        mkdir -p "$target_path"

        if [ -f "$target_path/$new_filename" ]; then
            existing_hash=$(b3sum "$target_path/$new_filename" | cut -d' ' -f1)
            new_hash=$(b3sum "$file" | cut -d' ' -f1)
            if [ "$existing_hash" = "$new_hash" ]; then
                verbose "skipping '$new_filename' (identical file already exists)"
                skipped=$((skipped + 1))
                continue
            else
                base="${new_filename%.*}"
                ext="${new_filename##*.}"
                base=$(echo "$base" | sed 's/-[0-9]\+$//')

                i=1
                while [ -f "$target_path/${base}-${i}.$ext" ]; do
                    i=$((i + 1))
                done

                new_filename="${base}-${i}.$ext"
                verbose "renaming to '$new_filename'"
                renamed=$((renamed + 1))
            fi
        fi
        
        cp "$file" "$target_path/$new_filename"
        [ -f "$target_path/$new_filename" ] || die "copy failed: $file"
        verbose "copying '$file' was successful"

        hash=$(b3sum "$target_path/$new_filename" | cut -d' ' -f1)
        verbose "$target_path/$new_filename (checksum: $hash)"
        echo "$hash|$target_path/$new_filename|$(date +%s)" >> "$CHECKSUMS_FILE"
        verbose "updated checksums file: $CHECKSUMS_FILE"
        copied=$((copied + 1))
    done < "$tmp_files"

    cleanup_tmp
    log "import complete: $count files ($copied copied, $skipped skipped, $renamed renamed)"
}

