cmd_config() {
    "$EDITOR" "$CONFIG_FILE"
}

cmd_version() {
    log "otb $VERSION"
    log 'Copyright (c) 2026 oatbiscuit'
    log 'License GPL-3.0-or-later'
}

cmd_help() {
    cat << 'EOF'
Usage: otb [OPTION] [COMMAND] [ARGUMENTS...]

Commands (short/long):
    i, import       [DIR]   Import files from a folder/media device.
    b, browse       [DIR]   Browse a folder in a TUI.
    t, tag          [FILE]  Add/remove tags from images.
    r, rate         [FILE]  Rate images (1-5 stars).
    f, find         [QUERY] Search images by tags/rating/date.
    e, export       [DIR]   Exported selected images with presets.
    d, dupes        [DIR]   Find duplicate images.
    s, stats        [DIR]   Show statistics for a folder.
    fsck            [DIR]   Check integrity of image collection.
    v, version              Show version information.
    config                  Edit configuration file. 

Options:
    --target        [DIR]   Override root directory for this command.
    --dry-run               Show what would be done without executing.
    -v, --verbose           Show detailed output.
    -h, --help              Show this help message.
    -V, --version           Show version information.

Environment Variables:
    IMG_ROOT                Default image directory (default: ~/Pictures).
    EDITOR                  Editor for config/tag editing (default: vi).
EOF
}

main() {
    mkdir -p "$(dirname "$CONFIG_FILE")"
    mkdir -p "$(dirname "$CHECKSUMS_FILE")"

    [ ! -f "$CONFIG_FILE" ] && touch "$CONFIG_FILE"
    [ ! -f "$CHECKSUMS_FILE" ] && touch "$CHECKSUMS_FILE"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --) shift; break ;;
            --target) TARGET_DIR="$2"; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -h|--help) cmd_help; exit 0;;
            -V|--version) cmd_version; exit 0 ;;
            -*) die "unknown option '$1'" 2 ;;
            *) break ;;
        esac
    done

    chk_depends

    case "${1:-}" in
        i|import) shift; cmd_import "$@" ;;
        config) cmd_config; exit 0 ;;
        ''|help) cmd_help; exit 0 ;;
        v|version) cmd_version; exit 0 ;;
        *) die "unknown command: '${1:-}'" 2 ;;
    esac
}

main "$@"
